{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/v1/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/r/:path*",
      "destination": "/api"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard.html"
    },
    {
      "source": "/ledger",
      "destination": "/ledger.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/verify",
      "destination": "/verify.html"
    },
    {
      "source": "/playground",
      "destination": "/playground.html"
    },
    {
      "source": "/student/dashboard",
      "destination": "/student/dashboard.html"
    },
    {
      "source": "/student/course",
      "destination": "/student/course.html"
    }
  ]
}
