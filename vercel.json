{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/v1/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/r/:path*",
      "destination": "/api"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard.html"
    },
    {
      "source": "/student/dashboard",
      "destination": "/student/dashboard.html"
    }
  ]
}
