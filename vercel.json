{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/r/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/student/dashboard",
      "destination": "/student-dashboard.html"
    },
    {
      "source": "/student/course",
      "destination": "/course-view.html"
    }
  ]
}
